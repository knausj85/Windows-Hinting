<!--
  PROTOTYPE — throwaway. Answers wayfinder ticket #59 (scroll-exposure probe),
  parent map #54 (keyboard-selectable scroll regions via UIA — viability).
  NOT part of Windows-Hinting.sln; not referenced by the main app; do NOT merge.
  Standalone console probe, driven by hand on Win11.

  BUILD NOTE: the COMReference (tlbimp) below requires FULL-FRAMEWORK MSBuild —
  `dotnet build`/`dotnet run` fail with MSB4803. Build with VS's MSBuild, e.g.:
    & (vswhere -latest -prerelease -find 'MSBuild\**\Bin\MSBuild.exe') -restore prototype\ScrollExposureProbe\ScrollExposureProbe.csproj
  then run bin\Debug\net10.0-windows\ScrollExposureProbe.exe. See README.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>ScrollExposureProbe</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Harmless COM SafeArray marshaling notice from the UIAutomationClient TLB. -->
    <MSBuildWarningsAsMessages>MSB3305</MSBuildWarningsAsMessages>
    <!-- UseWindowsForms: gives us Application.Run() (the message pump the global
         hotkey's WM_HOTKEY is delivered on) + NativeWindow for the hotkey sink. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Native COM UIA client (same TLB the main app uses). We use it for the
       ScrollPattern / ScrollItemPattern / RangeValuePattern reads + the ground-truth
       Scroll() actuation, which the managed System.Windows.Automation client models
       more awkwardly. -->
  <ItemGroup>
    <COMReference Include="UIAutomationClient">
      <WrapperTool>tlbimp</WrapperTool>
      <VersionMinor>0</VersionMinor>
      <VersionMajor>1</VersionMajor>
      <Guid>944de083-8fb8-45cf-bcb7-c477acb2f897</Guid>
      <Lcid>0</Lcid>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>

</Project>
