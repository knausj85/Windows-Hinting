<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Id="ProductPackage"
    Name="Windows-Hinting"
    Language="1033"
    Version="!(bind.FileVersion.WindowsHintingExe)"
    Manufacturer="Windows-Hinting"
    UpgradeCode="b2c3d4e5-f6a7-8901-bcde-f1234567890a"
    Scope="perMachine">
    <!-- Scope="perMachine" forces a per-machine install (ALLUSERS=1) and marks
         the package as requiring elevated privileges, so Windows Installer
         requests admin (UAC) automatically. This also lets an unelevated
         "msiexec /i" (e.g. the in-app auto-updater) trigger the UAC prompt
         instead of silently failing to write Program Files / HKLM. -->

    <Media Id="1" Cabinet="WindowsHinting.cab" EmbedCab="yes" />

    <!-- Upgrade strategy -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of [ProductName] is already installed."
      AllowSameVersionUpgrades="yes"
      Schedule="afterInstallInitialize" />

    <!-- Main Product Feature -->
    <Feature Id="ProductFeature" Title="Windows-Hinting" Level="1">
      <ComponentGroupRef Id="MainApplicationFiles" />
      <ComponentRef Id="DotNetRuntimeLibraries" />
      <ComponentGroupRef Id="NetSparkleResources" />
      <ComponentRef Id="RuntimeRegistry" />
      <ComponentGroupRef Id="DesktopShortcuts" />
      <ComponentGroupRef Id="RegistryConfiguration" />
    </Feature>

    <!-- Directory structure definition in Folders.wxs -->

    <!-- Application icon for shortcuts and Add/Remove Programs -->
    <Icon Id="AppIcon.ico" SourceFile="$(var.Windows_Hinting.TargetDir)Windows-Hinting.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <!-- License variable -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
  </Package>
</Wix>
