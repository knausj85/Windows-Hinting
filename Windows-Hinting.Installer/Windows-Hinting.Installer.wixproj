<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>Windows-Hinting</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- ICE61: MajorUpgrade uses AllowSameVersionUpgrades=yes on purpose, so reinstalling
         a rebuilt package with the same version upgrades in place. -->
    <SuppressIces>$(SuppressIces);ICE61</SuppressIces>
    <!-- See Windows-Hinting.csproj. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(GITHUB_ACTIONS)' == 'true'">true</RestoreLockedMode>
    <!-- The app's TargetDir (var.Windows_Hinting.TargetDir); Components.wxs excludes
         the portable publishes' RID subfolders only when they exist. -->
    <_AppTargetDir>$(MSBuildThisFileDirectory)..\Windows-Hinting\bin\$(Configuration)\net10.0-windows\</_AppTargetDir>
    <DefineConstants Condition="Exists('$(_AppTargetDir)win-x64')">$(DefineConstants);PortableX64OutputExists</DefineConstants>
    <DefineConstants Condition="Exists('$(_AppTargetDir)win-x86')">$(DefineConstants);PortableX86OutputExists</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Netfx.wixext" Version="6.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Windows-Hinting\Windows-Hinting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <WixCompile Include="Package.wxs" />
    <WixCompile Include="Components.wxs" />
    <WixCompile Include="Folders.wxs" />
    <WixCompile Include="UI.wxs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="License.rtf" />
  </ItemGroup>
</Project>
