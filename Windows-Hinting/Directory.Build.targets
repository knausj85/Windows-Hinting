<Project>
  <!-- Settings that depend on PortableBuild live here, not in the csproj: publish profiles
       (Properties/PublishProfiles/*.pubxml) are imported after the project body, so a
       PortableBuild set by a profile is only visible to properties evaluated after it.
       Directory.Build.targets is imported after the profile. -->

  <!-- Portable (self-contained single-file) builds: set by the Portable-win-* publish profiles.
       Emits a PORTABLE compile-time constant so UpdateService picks the portable appcast
       and PortableUpdateInstaller instead of the MSI install path. -->
  <PropertyGroup Condition="'$(PortableBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);PORTABLE</DefineConstants>
  </PropertyGroup>

  <!-- uiAccess=true only for the installed (MSI) Release build; Debug and portable builds
       can't use it. -->
  <PropertyGroup>
    <ApplicationManifest Condition="'$(Configuration)' == 'Release' And '$(PortableBuild)' != 'true'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(ApplicationManifest)' == ''">app.debug.manifest</ApplicationManifest>
  </PropertyGroup>
</Project>