<?xml version="1.0" encoding="utf-8"?>
<!-- Portable (self-contained single-file, no UIAccess) build for win-x64.
     Used by build/build-complete.ps1 -Portable, CI, and Visual Studio's Publish.
       dotnet publish Windows-Hinting/Windows-Hinting.csproj -p:PublishProfile=Portable-win-x64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <PortableBuild>true</PortableBuild>
    <PublishDir>$(MSBuildProjectDirectory)\bin-portable\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
