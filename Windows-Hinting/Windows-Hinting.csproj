
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Windows-Hinting</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest Condition="'$(Configuration)' == 'Release'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(Configuration)' != 'Release'">app.debug.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <EmbedInteropTypes>false</EmbedInteropTypes>
    <!-- Suppress harmless COM interop warning for CUIAutomation8.SafeArrayToRectNativeArray -->
    <MSBuildWarningsAsMessages>MSB3305</MSBuildWarningsAsMessages>
    </PropertyGroup>
  <ItemGroup>
    <Compile Remove=".github\**" />
    <Compile Remove="HintOverlay.Installer\**" />
    <Compile Remove="Windows-Hinting.Installer\**" />
    <EmbeddedResource Remove=".github\**" />
    <EmbeddedResource Remove="HintOverlay.Installer\**" />
    <EmbeddedResource Remove="Windows-Hinting.Installer\**" />
    <None Remove=".github\**" />
    <None Remove="HintOverlay.Installer\**" />
    <Compile Remove="Windows-Hinting\**" />
    <EmbeddedResource Remove="Windows-Hinting\**" />
    <None Remove="Windows-Hinting.Installer\**" />
    <None Remove="Windows-Hinting\**" />
  </ItemGroup>
  <ItemGroup>
    <COMReference Include="UIAutomationClient">
      <WrapperTool>tlbimp</WrapperTool>
      <VersionMinor>0</VersionMinor>
      <VersionMajor>1</VersionMajor>
      <Guid>944de083-8fb8-45cf-bcb7-c477acb2f897</Guid>
      <Lcid>0</Lcid>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.assert" Version="2.9.3" />
    <PackageReference Include="xunit.v3.extensibility.core" Version="3.2.2" />
  </ItemGroup>

</Project>
